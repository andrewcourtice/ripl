{
    "entryPointStrategy": "packages",
    "entryPoints": [
        "../../packages/canvas",
        "../../packages/core",
        "../../packages/charts",
        "../../packages/devtools",
        "../../packages/svg",
        "../../packages/web",
        "../../packages/3d",
        "../../packages/webgpu",
        "../../packages/terminal",
        "../../packages/dom",
        "../../packages/utilities",
        "../../packages/adapters",
        "../../packages/adapters-3d",
        "../../packages/adapters-charts",
        "../../adapters/vue",
        "../../adapters/vue-3d",
        "../../adapters/vue-charts",
        "../../adapters/react",
        "../../adapters/react-3d",
        "../../adapters/react-charts"
    ],
    "out": "./src/docs/api",
    "plugin": [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme"
    ],
    "docsRoot": "./src",
    "parametersFormat": "table",
    "interfacePropertiesFormat": "table",
    "classPropertiesFormat": "table",
    "enumMembersFormat": "table",
    "indexFormat": "table",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "sidebar": {
        "autoConfiguration": true,
        "pretty": true,
        "collapsed": true
    }
}
