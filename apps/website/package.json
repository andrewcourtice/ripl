{
    "name": "@ripl/website",
    "private": true,
    "scripts": {
        "generate-api": "typedoc",
        "prepare-playground": "node scripts/prepare-playground.mjs",
        "start": "yarn generate-api && yarn prepare-playground && vitepress dev ./src",
