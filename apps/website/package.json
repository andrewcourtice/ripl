        "@ripl/devtools": "workspace:^",
        "@ripl/node": "workspace:^",
        "@ripl/svg": "workspace:^",
        "@ripl/terminal": "workspace:^",
        "@ripl/utilities": "workspace:^",
        "@ripl/web": "workspace:^",
        "@ripl/webgpu": "workspace:^",
        "@vue/devtools-api": "^8.2.1",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "flex-layout-attribute": "^1.0.3",
        "lucide-vue-next": "^1.0.0",
        "monaco-editor": "^0.56.0",
        "pinia": "^4.0.2",
        "sass": "^1.102.0",
        "vue": "^3.5.40"
    },
