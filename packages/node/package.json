{
    "name": "@ripl/node",
    "version": "1.3.0",
    "description": "Node.js runtime bindings for Ripl",
    "keywords": [
        "ripl",
        "typescript",
        "graphics",
        "2d",
        "data-visualization",
        "zero-dependency",
        "node",
        "nodejs",
        "ssr",
        "server-side-rendering",
        "headless",
        "terminal"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andrewcourtice/ripl.git",
        "directory": "packages/node"
    },
    "bugs": "https://github.com/andrewcourtice/ripl/issues",
    "author": "Andrew Courtice <andrewcourtice@users.noreply.github.com>",
    "homepage": "https://www.ripl.run",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown"
    },
    "dependencies": {
        "@ripl/core": "workspace:^",
        "@ripl/terminal": "workspace:^",
        "@ripl/utilities": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^24.13.3"
    }
}
