{
    "name": "@ripl/core",
    "version": "1.3.0",
    "description": "Core rendering library for Ripl: elements, scene, renderer, animation, scales, math, color, interpolation",
    "keywords": [
        "ripl",
        "typescript",
        "graphics",
        "2d",
        "data-visualization",
        "zero-dependency",
        "animation",
        "easing",
        "interpolation",
        "scene-graph",
        "scales",
        "drawing",
        "canvas",
        "svg"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andrewcourtice/ripl.git",
        "directory": "packages/core"
    },
    "bugs": "https://github.com/andrewcourtice/ripl/issues",
    "author": "Andrew Courtice <andrewcourtice@users.noreply.github.com>",
    "homepage": "https://www.ripl.run",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown"
    },
    "dependencies": {
        "@ripl/utilities": "workspace:^"
    }
}
