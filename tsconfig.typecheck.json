// The type gate: tsdown emits declarations without semantic diagnostics, so `tsc` never runs in the build.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // A single program spans every package, so it needs the union of their ambient types.
        "types": [
            "vitest/importMeta",
            "@webgpu/types",
            "node",
            "chrome"
        ]
    },
    // The extension's `.vue` blocks need `vue-tsc` and stay uncovered; its `.ts` is checked here.
    "include": [
        "packages/*/src/**/*.ts",
        "apps/devtools-extension/src/**/*.ts"
    ]
}
